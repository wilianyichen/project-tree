if HAS_TEXTUAL and HAS_RICH:

    class DetailPanel(Static):
        """Right panel: stats overview or node details."""

        def show_stats(self, stats, theme):
            s = stats
            desc_pct = s['with_desc'] / max(s['total_nodes'], 1) * 100
            lines = [
                f"[{theme.tui_style('panel_title')}]  Server Project Tree  [/]",
                "",
                f"  [{theme.tui_style('stats_number')}]{s['total_nodes']:>6}[/]  [{theme.tui_style('stats_label')}]Nodes[/]",
                f"  [{theme.tui_style('stats_number')}]{s['projects']:>6}[/]  [{theme.tui_style('stats_label')}]Projects[/]",
                f"  [{theme.tui_style('stats_number')}]{s['data_nodes']:>6}[/]  [{theme.tui_style('stats_label')}]Data[/]",
                f"  [{theme.tui_style('stats_number')}]{s['containers']:>6}[/]  [{theme.tui_style('stats_label')}]Containers[/]",
                f"  [{theme.tui_style('stats_number')}]{s['symlinks']:>6}[/]  [{theme.tui_style('stats_label')}]Symlinks[/]",
                f"  [{theme.tui_style('stats_number')}]{s['highlights']:>6}[/]  [{theme.tui_style('stats_label')}]Highlighted[/]",
                "",
                f"  [{theme.tui_style('detail_label')}]Described:[/] {s['with_desc']}/{s['total_nodes']} ({desc_pct:.0f}%)",
            ]
            self.update("\n".join(lines))

        def show_detail(self, node, theme):
            name = node.get('name', '')
            path = node.get('path', '')
            ntype = node.get('type', '?')
            category = node.get('category', '?')
            size = node.get('size') or '—'
            description = node.get('description', '')
            highlight = node.get('highlight', False)
            is_symlink = node.get('is_symlink', False)
            symlink_target = node.get('symlink_target', '')
            markers = node.get('markers', [])
            depth = node.get('depth', 0)
            children_count = len(node.get('children') or [])

            cat_style = theme.category_style(category)
            hl_mark = ' ★' if highlight else ''

            display_name = name
            if ntype in ('container', 'project', 'workspace', 'data'):
                display_name += '/'

            lines = [
                f"  [{cat_style}]{display_name}[/]{hl_mark}",
                "",
                f"  [{theme.tui_style('detail_label')}]Path:[/]      [{theme.tui_style('detail_value')}]{path}[/]",
                f"  [{theme.tui_style('detail_label')}]Type:[/]      [{theme.tui_style('detail_value')}]{ntype}[/]",
                f"  [{theme.tui_style('detail_label')}]Category:[/]   [{cat_style}]{category}[/]",
                f"  [{theme.tui_style('detail_label')}]Size:[/]       [{theme.tui_style('detail_value')}]{size}[/]",
                f"  [{theme.tui_style('detail_label')}]Depth:[/]      [{theme.tui_style('detail_value')}]{depth}[/]",
                f"  [{theme.tui_style('detail_label')}]Children:[/]   [{theme.tui_style('detail_value')}]{children_count}[/]",
            ]
            if markers:
                lines.append(f"  [{theme.tui_style('detail_label')}]Markers:[/]    [{theme.tui_style('detail_value')}]{', '.join(markers)}[/]")
            if is_symlink and symlink_target:
                lines.append(f"  [{theme.tui_style('detail_label')}]Symlink:[/]    [{theme.tui_style('detail_value')}]{symlink_target}[/]")
            if description:
                lines.append(f"")
                lines.append(f"  [{theme.style('description')}]{description}[/]")
            self.update("\n".join(lines))


    class ProjectTreeTUI(App):
        """Interactive server project tree explorer — dual-color model."""

        CSS = """
        #tree-panel {
            width: 2fr;
            border: solid $primary;
            background: $surface;
        }
        #detail-panel {
            width: 1fr;
            border: solid $primary;
            background: $surface;
            padding: 1;
        }
        #search-input {
            dock: top;
            margin: 1;
            width: 40;
        }
        #depth-badge {
            dock: bottom;
            height: 1;
            content-align: center middle;
        }
        Tree > .tree--guides {
            color: $text-disabled;
        }
        Tree:focus > .tree--cursor {
            background: $accent 30%;
        }
        """

        BINDINGS = [
            Binding("q", "quit", "Quit"),
            Binding("up", "cursor_up", "Up"),
            Binding("down", "cursor_down", "Down"),
            Binding("enter", "toggle_node", "Expand/Collapse"),
            Binding("space", "toggle_node", "Expand/Collapse"),
            Binding("d", "cycle_depth", "Depth +"),
            Binding("s", "cycle_depth_reverse", "Depth -"),
            Binding("t", "zoom_in", "Zoom In"),
            Binding("r", "zoom_out", "Zoom Out"),
            Binding("e", "enter_dir", "Enter Dir"),
            Binding("f", "search_mode", "Find"),
            Binding("escape", "clear_search", "Clear"),
            Binding("g", "scroll_home", "Home"),
            Binding("G", "scroll_end", "End"),
        ]

        def __init__(self, annotated_path=None, theme_name="dracula",
                     max_depth=4, display_depth=None):
            super().__init__()
            self.annotated_path = annotated_path or ANNOTATED_PATH
            self.theme_name = theme_name
            self.max_depth = max_depth
            self.display_depth = display_depth if display_depth is not None else max(1, max_depth - 1)
            self.search_active = False
            self._all_node_data = []
            self._zoom_stack = []  # stack of (roots_data, display_depth) for zoom-out

        def compose(self) -> ComposeResult:
            yield Header()
            with Horizontal():
                yield TTree("Loading...", id="tree-panel")
                yield DetailPanel(id="detail-panel")
            yield Footer()

        def on_mount(self):
            self.pt_theme = ThemeManager(self.theme_name)
            self._load_data()

        def _load_data(self):
            if not os.path.exists(self.annotated_path):
                self.query_one("#tree-panel", TTree).root.set_label(
                    f"No data found. Run: project-tree update")
                return
            try:
                data = load_json(self.annotated_path)
            except Exception as e:
                self.query_one("#tree-panel", TTree).root.set_label(f"Error: {e}")
                return

            self._all_node_data = []
            for root_node in data.get('roots', []):
                self._all_node_data.extend(walk_nodes(root_node))
            self.roots_data = data.get('roots', [])
            self._populate_tree()
            self._show_stats()

        def _populate_tree(self):
            tree = self.query_one("#tree-panel", TTree)
            tree.clear()
            tree.root.set_label(Text.from_markup("[bold]Server Project Tree[/]"))

            for root_data in self.roots_data:
                label = self._make_node_label(root_data, is_collapsed=bool(root_data.get('children')))
                root_node = tree.root.add(label, expand=True)
                root_node.data = root_data

                for child in (root_data.get('children') or []):
                    self._add_tree_node(root_node, child, 1)

            tree.focus()

        def _add_tree_node(self, parent, node_data, depth):
            children = node_data.get('children') or []
            has_children = bool(children)
            show_children = has_children and depth < self.display_depth

            label = self._make_node_label(node_data, is_collapsed=has_children)
            tree_node = parent.add(label, expand=False)
            tree_node.data = node_data

            if show_children:
                for child in children:
                    self._add_tree_node(tree_node, child, depth + 1)

        def _make_node_label(self, node_data, is_collapsed=True):
            name = node_data.get('name', '')
            ntype = node_data.get('type', '')
            category = node_data.get('category', '')
            description = node_data.get('description', '')
            has_children = bool(node_data.get('children'))

            indicator = ''
            if has_children or ntype in ('container', 'root'):
                state = 'collapsed' if is_collapsed else 'expanded'
                s = self.pt_theme.indicators.get(state, 'bold white')
                sym = '[+] ' if is_collapsed else '[-] '
                indicator = f'[{s}]{sym}[/]'

            display_name = name
            if ntype in ('container', 'project', 'workspace', 'data'):
                display_name += '/'

            cat_s = self.pt_theme.colors.get(category) or 'white'
            name_part = f'[{cat_s}]{display_name}[/]'

            parts = [indicator, name_part] if indicator else [name_part]

            if description:
                desc_s = self.pt_theme.styles.get('description') or 'italic'
                parts.append(f'  [{desc_s}]\N{LEFTWARDS ARROW} {description}[/]')

            return Text.from_markup(''.join(parts))

        def on_tree_node_expanded(self, event: TTree.NodeExpanded):
            node = event.node
            if node.data:
                node_data = node.data
                # Update label: [+] → [-]
                node.set_label(self._make_node_label(node_data, is_collapsed=False))
                # Lazy-load children if not loaded (beyond display_depth)
                if not node.children:
                    for child in (node_data.get('children') or []):
                        child_depth = node_data.get('depth', 0) + 1
                        self._add_tree_node(node, child, child_depth)

        def on_tree_node_collapsed(self, event: TTree.NodeCollapsed):
            node = event.node
            if node.data:
                node.set_label(self._make_node_label(node.data, is_collapsed=True))

        def on_tree_node_highlighted(self, event: TTree.NodeHighlighted):
            node = event.node
            panel = self.query_one("#detail-panel", DetailPanel)
            if node.data:
                panel.show_detail(node.data, self.pt_theme)
            else:
                self._show_stats()
            # Scroll padding: keep cursor away from viewport top/bottom edges
            tree = self.query_one("#tree-panel", TTree)
            self._center_cursor(node)

        def _center_cursor(self, node):
            """Scroll so the highlighted node isn't at the very top or bottom edge."""
            tree = self.query_one("#tree-panel", TTree)
            tree.scroll_to_node(node, animate=False)
            PAD = 4

            def _nudge():
                line = tree.cursor_line
                if line is None:
                    return
                vh = tree.scrollable_content_region.height
                sy = tree.scroll_offset.y
                rel = line - sy
                if rel < PAD and sy > 0:
                    tree.scroll_to(y=max(0, line - PAD), animate=False)
                elif rel > vh - PAD - 1:
                    tree.scroll_to(y=max(0, line - vh + PAD + 1), animate=False)

            self.call_after_refresh(_nudge)

        def action_toggle_node(self):
            tree = self.query_one("#tree-panel", TTree)
            if tree.cursor_node is not None:
                node = tree.cursor_node
                if node.is_expanded:
                    node.collapse()
                else:
                    node.expand()

        def action_cycle_depth(self):
            self.display_depth = (self.display_depth % self.max_depth) + 1
            self._repopulate()
            self._show_stats()
            self.notify(f"Display depth: {self.display_depth}/{self.max_depth}",
                       timeout=2)

        def action_cycle_depth_reverse(self):
            self.display_depth = ((self.display_depth - 2) % self.max_depth) + 1
            self._repopulate()
            self._show_stats()
            self.notify(f"Display depth: {self.display_depth}/{self.max_depth}",
                       timeout=2)

        def action_enter_dir(self):
            """Write selected path to last-cd file and quit."""
            tree = self.query_one("#tree-panel", TTree)
            node = tree.cursor_node
            if node is None or not node.data:
                self.notify("No node selected", timeout=2)
                return

            node_data = node.data
            path = node_data.get('path', '')
            ntype = node_data.get('type', '')

            # If it's a file, use its parent dir
            if ntype not in ('root', 'container', 'workspace', 'project') and not node_data.get('children'):
                path = os.path.dirname(path)

            if path and os.path.isdir(path):
                last_cd = os.path.expanduser('~/.cache/project-tree-last-cd')
                os.makedirs(os.path.dirname(last_cd), exist_ok=True)
                with open(last_cd, 'w') as f:
                    f.write(path)
                self.exit()
            else:
                self.notify(f"Not a directory: {path}", timeout=2)

        def action_zoom_in(self):
            """Zoom into the selected node's subtree."""
            tree = self.query_one("#tree-panel", TTree)
            node = tree.cursor_node
            if node is None or not node.data:
                return

            node_data = node.data
            ntype = node_data.get('type', '')

            # If it's a file/leaf, zoom to its parent
            if ntype not in ('root', 'container', 'workspace', 'project') and not node_data.get('children'):
                # Find parent by walking roots
                parent_data = self._find_parent(node_data)
                if parent_data:
                    node_data = parent_data

            children = node_data.get('children')
            if not children:
                self.notify("No children to zoom into", timeout=2)
                return

            # Push current state to zoom stack
            self._zoom_stack.append((self.roots_data, self.display_depth))
            # Set new roots
            self.roots_data = [node_data]
            self.display_depth = self.max_depth  # show all levels when zoomed in
            self._repopulate()

            name = node_data.get('name', '')
            self.notify(f"Zoomed into: {name}/  (r to zoom out)", timeout=3)

        def action_zoom_out(self):
            """Zoom back out to previous view."""
            if not self._zoom_stack:
                self.notify("Already at top level", timeout=2)
                return
            self.roots_data, self.display_depth = self._zoom_stack.pop()
            self._repopulate()
            self.notify("Zoomed out", timeout=2)

        def _find_parent(self, target_data):
            """Find the parent node_data for a given node by walking all roots."""
            target_path = target_data.get('path', '')
            if not target_path:
                return None
            parent_path = os.path.dirname(target_path)

            all_nodes = []
            for root in self.roots_data:
                all_nodes.extend(walk_nodes(root))
            for n in all_nodes:
                if n.get('path') == parent_path:
                    return n
            return None

        def action_search_mode(self):
            self.search_active = True
            search_input = Input(placeholder="Search...", id="search-input")
            self.mount(search_input)
            search_input.focus()

        def action_clear_search(self):
            if self.search_active:
                try:
                    self.query_one("#search-input", Input).remove()
                except Exception:
                    pass
                self.search_active = False
                self._repopulate()
                self._show_stats()
                self.query_one("#tree-panel", TTree).focus()

        def on_input_submitted(self, event: Input.Submitted):
            if event.widget.id == "search-input":
                self._apply_search(event.value)

        def on_input_changed(self, event: Input.Changed):
            if event.widget.id == "search-input":
                if not event.value:
                    self._repopulate()
                else:
                    self._apply_search(event.value)

        def _apply_search(self, term):
            if not term:
                self._repopulate()
                return
            term_lower = term.lower()
            tree = self.query_one("#tree-panel", TTree)
            tree.clear()

            for root_data in self.roots_data:
                filtered = self._filter_tree(root_data, term_lower)
                if filtered is not None:
                    label = self._make_node_label(root_data, is_collapsed=False)
                    root_node = tree.root.add(label, expand=True)
                    root_node.data = root_data
                    for child in (filtered.get('children') or []):
                        self._add_tree_node(root_node, child, 0)
                    root_node.expand()

            self.notify(f"Search: '{term}' — matching nodes shown", timeout=2)

        def _filter_tree(self, node_data, term_lower):
            """Return node_data with filtered children if it or any descendant matches, else None."""
            name = node_data.get('name', '').lower()
            desc = (node_data.get('description') or '').lower()
            self_matches = term_lower in name or term_lower in desc

            children = node_data.get('children') or []
            filtered_children = []
            for child in children:
                result = self._filter_tree(child, term_lower)
                if result is not None:
                    filtered_children.append(result)

            if self_matches or filtered_children:
                result = dict(node_data)
                result['children'] = filtered_children
                return result
            return None

        def _repopulate(self, restore_cursor=True):
            # Save cursor path before clearing
            cursor_path = None
            if restore_cursor:
                tree = self.query_one("#tree-panel", TTree)
                if tree.cursor_node and tree.cursor_node.data:
                    cursor_path = tree.cursor_node.data.get('path')

            tree = self.query_one("#tree-panel", TTree)
            tree.clear()
            self._populate_tree()

            if cursor_path:
                self._restore_cursor(cursor_path)

        def _restore_cursor(self, path):
            """Find a node by path (or nearest ancestor) and move cursor to it."""
            tree = self.query_one("#tree-panel", TTree)

            def _find(node, target):
                if node.data and node.data.get('path') == target:
                    return node
                for child in node.children:
                    r = _find(child, target)
                    if r:
                        return r
                return None

            target = _find(tree.root, path)
            # If exact path not found (depth reduced), walk up to nearest ancestor
            while target is None and path and path != '/':
                path = os.path.dirname(path)
                target = _find(tree.root, path)

            if target:
                tree.select_node(target)
                tree.scroll_to_node(target, animate=False)

        def _show_stats(self):
            nodes = self._all_node_data
            if not nodes:
                nodes = []
                for root in self.roots_data:
                    nodes.extend(walk_nodes(root))
                self._all_node_data = nodes

            stats = {
                'total_nodes': len(nodes),
                'projects': sum(1 for n in nodes if n.get('type') == 'project'),
                'workspaces': sum(1 for n in nodes if n.get('type') == 'workspace'),
                'data_nodes': sum(1 for n in nodes if n.get('type') == 'data'),
                'containers': sum(1 for n in nodes if n.get('type') == 'container'),
                'symlinks': sum(1 for n in nodes if n.get('is_symlink')),
                'highlights': sum(1 for n in nodes if n.get('highlight')),
                'with_desc': sum(1 for n in nodes if n.get('description')),
            }
            panel = self.query_one("#detail-panel", DetailPanel)
            panel.show_stats(stats, self.pt_theme)

        def action_scroll_home(self):
            tree = self.query_one("#tree-panel", TTree)
            tree.scroll_home(animate=False)

        def action_scroll_end(self):
            tree = self.query_one("#tree-panel", TTree)
            tree.scroll_end(animate=False)


# ═══════════════════════════════════════════════════════════════════════════════
# Find + Stats
# ═══════════════════════════════════════════════════════════════════════════════

def cmd_find(args):
    data = load_json(args.input)
    all_nodes = []
    for root in data.get('roots', []):
        all_nodes.extend(walk_nodes(root))

    results = []
    for n in all_nodes:
        name = n.get('name', '')
        path = n.get('path', '')
        cat = n.get('category', '')
        ntype = n.get('type', '')
        desc = n.get('description', '')
        hl = n.get('highlight', False)
        depth = n.get('depth', 0)

        if args.name and args.name.lower() not in name.lower():
            continue
        if args.category and cat != args.category:
            continue
        if args.type and ntype != args.type:
            continue
        if args.path and args.path not in path:
            continue
        if args.highlight and not hl:
            continue
        if args.no_desc and desc:
            continue
        if args.depth is not None and depth != args.depth:
            continue
        results.append(n)

    if getattr(args, 'json', False):
        output = [{k: v for k, v in n.items() if k != 'children'} for n in results]
        print(json.dumps(output, ensure_ascii=False, indent=2))
        return

    if not results:
        print("No matches.")
        return

    max_name = min(max(len(n['name']) for n in results), 40)
    max_type = min(max(len(n.get('type', '')) for n in results), 12)
    max_cat = min(max(len(n.get('category', '')) for n in results), 12)
    print(f"  {'NAME':<{max_name}}  {'TYPE':<{max_type}}  {'CATEGORY':<{max_cat}}  H  PATH")
    print(f"  {'─'*max_name}  {'─'*max_type}  {'─'*max_cat}  ─  {'─'*50}")
    for n in results:
        nm = n['name'][:max_name]
        nt = n.get('type', '')[:max_type]
        nc = n.get('category', '')[:max_cat]
        hl = '★' if n.get('highlight') else ' '
        d = n.get('description', '')
        detail = f"  ← {d}" if d else ''
        print(f"  {nm:<{max_name}}  {nt:<{max_type}}  {nc:<{max_cat}}  {hl}  {n['path']}{detail}")
    print(f"\n  {len(results)} match(es)")


def cmd_stats(args):
    data = load_json(args.input)
    nodes = []
    for root in data.get('roots', []):
        nodes.extend(walk_nodes(root))

    by_type = Counter(n.get('type', '?') for n in nodes)
    by_cat = Counter(n.get('category', '?') for n in nodes)
    with_desc = sum(1 for n in nodes if n.get('description'))
    highlights = sum(1 for n in nodes if n.get('highlight'))
    symlinks = sum(1 for n in nodes if n.get('is_symlink'))
    max_depth = max((n.get('depth', 0) for n in nodes), default=0)
    roots_count = sum(1 for n in nodes if n.get('depth') == 0)

    if getattr(args, 'json', False):
        print(json.dumps({
            'generated_at': data.get('generated_at', '?'),
            'annotated_at': data.get('annotated_at', '?'),
            'annotated_by': data.get('annotated_by', '?'),
            'total_nodes': len(nodes), 'roots': roots_count, 'max_depth': max_depth,
            'by_type': dict(by_type), 'by_category': dict(by_cat),
            'with_desc': with_desc, 'without_desc': len(nodes) - with_desc,
            'highlights': highlights, 'symlinks': symlinks,
        }, ensure_ascii=False, indent=2))
        return

    print(f"Server Project Tree")
    print(f"  Generated:  {data.get('generated_at', '?')}")
    print(f"  Annotated:  {data.get('annotated_at', '?')} ({data.get('annotated_by', '?')})")
    print(f"  Watch roots: {roots_count}")
    print(f"  Max depth:   {max_depth}")
    print(f"  Total nodes: {len(nodes)}")
    print()
    print('  By Category:')
    for cat, count in by_cat.most_common():
        pct = count / len(nodes) * 100
        bar = '█' * int(pct / 2)
        print(f'    {cat:<14} {count:>4}  {bar}')
    print()
    print('  By Type:')
    for ntype, count in by_type.most_common():
        pct = count / len(nodes) * 100
        bar = '█' * int(pct / 2)
        print(f'    {ntype:<14} {count:>4}  {bar}')
    print()
    desc_pct = with_desc / len(nodes) * 100
    print(f'  Described:  {with_desc}/{len(nodes)} ({desc_pct:.0f}%)')
    print(f'  Highlights: {highlights}')
    print(f'  Symlinks:   {symlinks}')


# ═══════════════════════════════════════════════════════════════════════════════
# Update Pipeline
# ═══════════════════════════════════════════════════════════════════════════════

def cmd_update(args):
    """Full pipeline: save baseline → scan → diff → annotate → render md."""
    print("=== Scanning ===")
    # Save baseline
    if os.path.exists(RAW_PATH):
        import shutil
        shutil.copy(RAW_PATH, BASELINE_PATH)
    config = load_scan_config()
    if args.max_depth:
        config["max_depth"] = args.max_depth
    include_sizes = not args.no_size
    t0 = time.time()
    roots = []
    for root_path, display_name in config["watch_roots"]:
        if not os.path.exists(root_path):
            print(f"Warning: root not found: {root_path}", file=sys.stderr)
            continue
        node = scan_root(root_path, display_name, config, include_sizes)
        if node:
            roots.append(node)
    elapsed = time.time() - t0
    output = {
        "version": "1.0",
        "generated_at": time.strftime("%Y-%m-%dT%H:%M:%S"),
        "scan_duration_s": round(elapsed, 2),
        "scan_config": {
            "max_depth": config["max_depth"],
            "skip_names": sorted(config["skip_names"]),
            "project_markers": sorted(config["project_markers"]),
            "data_patterns": sorted(config["data_patterns"]),
        },
        "roots": roots,
    }
    with open(RAW_PATH, "w", encoding="utf-8") as f:
        json.dump(output, f, ensure_ascii=False, indent=2)
    print(f"  {len(roots)} roots, {elapsed:.1f}s")

    # Diff
    if os.path.exists(BASELINE_PATH):
        print()
        print("=== Changes ===")
        baseline = load_json(BASELINE_PATH)
        current = output
        result = compute_diff(baseline, current)
        added = sum(1 for c in result['changes'] if c['type'] == 'added')
        removed = sum(1 for c in result['changes'] if c['type'] == 'removed')
        changed = sum(1 for c in result['changes'] if c['type'] in ('type_changed', 'structure_changed'))
        unchanged = result['total_new'] - added - changed
        print(f"  {added} added, {removed} removed, {changed} changed, {unchanged} unchanged")

    # Annotate
    print()
    print("=== Annotating ===")
    data = output
    desc_map, highlights = load_descriptions()
    corrections = load_corrections()
    for root in data.get('roots', []):
        annotate_node(root, desc_map, highlights, corrections)
    data['annotated_at'] = time.strftime('%Y-%m-%dT%H:%M:%S')
    provenance = 'claude-heuristics + descriptions.json'
    if corrections:
        provenance += f' + {len(corrections)} corrections'
    data['annotated_by'] = provenance
    with open(ANNOTATED_PATH, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
    print(f"  annotated {'+ corrections' if corrections else ''}")

    # Render MD
    print()
    print("=== Rendering PROJECT-TREE.md ===")
    if HAS_RICH:
        renderer = MarkdownRenderer(source_json_path=ANNOTATED_PATH)
        renderer.write(roots, MD_OUTPUT)
        print(f"  {MD_OUTPUT}")
    else:
        print("  skipped (rich not available)")

    print()
    print("Done. Review with: project-tree diff --summary")
    print("To fix annotations: edit ~/.config/project-tree/corrections.json")


def cmd_tui(args):
    """Launch interactive Textual TUI."""
    if not HAS_TEXTUAL:
        print("Error: 'textual' library required for TUI. Install: pip install textual",
              file=sys.stderr)
        print("Fallback: use 'project-tree render split' for one-shot view.",
              file=sys.stderr)
        sys.exit(1)
    if not HAS_RICH:
        print("Error: 'rich' library required. Install: pip install rich",
              file=sys.stderr)
        sys.exit(1)
    if not os.path.exists(args.input):
        print(f"No annotated JSON found at {args.input}.", file=sys.stderr)
        print("Run 'project-tree update' first.", file=sys.stderr)
        sys.exit(1)

    # Load scan config for max_depth
    try:
        config = load_scan_config()
        max_depth = config.get('max_depth', 4)
    except Exception:
        max_depth = 4

    display_depth = args.depth if hasattr(args, 'depth') and args.depth else max(1, max_depth - 1)
    app = ProjectTreeTUI(
        annotated_path=args.input,
        theme_name=args.theme,
        max_depth=max_depth,
        display_depth=display_depth,
    )
    app.run()


# ═══════════════════════════════════════════════════════════════════════════════
# Main CLI
# ═══════════════════════════════════════════════════════════════════════════════

def build_parser():
    p = argparse.ArgumentParser(
        description="Unified server project tree CLI",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="Default (no subcommand): interactive TUI explorer.\n"
               "For one-shot: project-tree render [tree|table|dash|split|md]"
    )
    p.add_argument('--theme', '-t', default='dracula',
                   help='Color theme (dracula)')
    p.add_argument('--list-themes', action='store_true',
                   help='List available themes and exit')

    sub = p.add_subparsers(dest='command', title='Subcommands')

    # scan
    sp_scan = sub.add_parser('scan', help='Scan filesystem → raw JSON')
    sp_scan.add_argument('-o', '--output', default=RAW_PATH)
    sp_scan.add_argument('--no-size', action='store_true')
    sp_scan.add_argument('--max-depth', type=int)

    # render
    sp_render = sub.add_parser('render', help='Render annotated JSON')
    sp_render.add_argument('mode', nargs='?', default='split',
                           choices=['tree', 'table', 'dash', 'split', 'md'])
    sp_render.add_argument('-i', '--input', default=ANNOTATED_PATH)
    sp_render.add_argument('-o', '--output')
    sp_render.add_argument('--compact', action='store_true')
    sp_render.add_argument('--no-size', action='store_true')
    sp_render.add_argument('--theme', default='dracula')

    # annotate
    sp_annotate = sub.add_parser('annotate', help='Heuristic annotation + corrections')
    sp_annotate.add_argument('-i', '--input', default=RAW_PATH)
    sp_annotate.add_argument('-o', '--output', default=ANNOTATED_PATH)
    sp_annotate.add_argument('--descriptions-file', default=DESCRIPTIONS_PATH)
    sp_annotate.add_argument('--corrections-file', default=CORRECTIONS_PATH)

    # corrections
    sp_corr = sub.add_parser('corrections', help='Apply corrections.json')
    sp_corr.add_argument('-i', '--input', required=True)
    sp_corr.add_argument('-o', '--output', required=True)
    sp_corr.add_argument('--corrections-file', default=CORRECTIONS_PATH)

    # diff
    sp_diff = sub.add_parser('diff', help='Compare two raw JSON scans')
    sp_diff.add_argument('--baseline', required=True)
    sp_diff.add_argument('--current', required=True)
    sp_diff.add_argument('--json', action='store_true')
    sp_diff.add_argument('--summary', action='store_true')

    # find
    sp_find = sub.add_parser('find', help='Query annotated JSON')
    sp_find.add_argument('name', nargs='?')
    sp_find.add_argument('--category')
    sp_find.add_argument('--type', dest='type')
    sp_find.add_argument('--path', dest='path')
    sp_find.add_argument('--highlight', action='store_true')
    sp_find.add_argument('--no-desc', action='store_true')
    sp_find.add_argument('--depth', type=int)
    sp_find.add_argument('-i', '--input', default=ANNOTATED_PATH)
    sp_find.add_argument('--json', action='store_true')

    # stats
    sp_stats = sub.add_parser('stats', help='Print summary statistics')
    sp_stats.add_argument('-i', '--input', default=ANNOTATED_PATH)
    sp_stats.add_argument('--json', action='store_true')

    # update
    sp_update = sub.add_parser('update', help='Full pipeline: scan → annotate → render md')
    sp_update.add_argument('--no-size', action='store_true')
    sp_update.add_argument('--max-depth', type=int)

    # tui
    sp_tui = sub.add_parser('tui', help='Interactive TUI explorer (default when no subcommand)')
    sp_tui.add_argument('-i', '--input', default=ANNOTATED_PATH)
    sp_tui.add_argument('--theme', default='dracula')
    sp_tui.add_argument('--depth', type=int)

    return p


def main():
    parser = build_parser()
    args = parser.parse_args()

    if args.list_themes and HAS_RICH:
        themes = ThemeManager.list_themes()
        if not themes:
            print("No themes found.")
            return
        print(f"{'Key':<12} {'Name':<20} Description")
        print("-" * 60)
        for key, name, desc in themes:
            print(f"{key:<12} {name:<20} {desc}")
        return
    elif args.list_themes:
        print("Error: 'rich' library required for themes.", file=sys.stderr)
        return

    # Dispatch subcommand
    if args.command == 'scan':
        cmd_scan(args)
    elif args.command == 'render':
        cmd_render(args)
    elif args.command == 'annotate':
        cmd_annotate(args)
    elif args.command == 'corrections':
        cmd_corrections(args)
    elif args.command == 'diff':
        cmd_diff(args)
    elif args.command == 'find':
        cmd_find(args)
    elif args.command == 'stats':
        cmd_stats(args)
    elif args.command == 'update':
        cmd_update(args)
    elif args.command == 'tui':
        cmd_tui(args)
    elif args.command is None:
        # Default: interactive TUI
        cmd_tui(argparse.Namespace(
            input=ANNOTATED_PATH,
            theme=getattr(args, 'theme', 'dracula'),
            depth=None,
        ))
    else:
        parser.print_help()


if __name__ == '__main__':
    main()
